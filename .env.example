# Copie para .env (arquivo ignorado pelo Git) e preencha SOMENTE se quiser enviar alertas por um SMTP real.
# Sem este arquivo, os alertas vao para o Mailpit (http://localhost:8025).
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=senha
# SMTP_TLS=starttls      # none | starttls | ssl
# ALERT_TO=voce@exemplo.com
# ALERT_FROM=alertas@exemplo.com
# DASHBOARD_URL=http://localhost:8000
